local function sv(d,p) if d then for k,v in pairs(p) do pcall(function() d[k]=v end) end end end
local function hideVis() for _,d in pairs(VIS) do if d then pcall(function() d.Visible=false end) end end end

local function updateVis(ball, hrp, bv, range, isTargeted, curved)
    if not CFG.Visualizer or not ball or not hrp then hideVis(); return end
    local spd  = bv.Magnitude
    local dist = LP:DistanceFromCharacter(ball.Position)
    local dir  = hrp.Position - ball.Position
    local dot  = dir.Magnitude > 0 and dir.Unit:Dot(bv.Unit) or 0
    local appr = dot > 0.05

    local tta = getAbsoluteTTA(ball, hrp, bv)
    local pred = ball.Position + bv * math.min(tta == math.huge and 0.4 or tta, 0.4)
    local bp3,bOn = Camera:WorldToViewportPoint(ball.Position)
    local pp3,pOn = Camera:WorldToViewportPoint(pred)
    local ep3 = Camera:WorldToViewportPoint(hrp.Position)
    local bp2 = Vector2.new(bp3.X,bp3.Y)
    local pp2 = Vector2.new(pp3.X,pp3.Y)
    local ep2 = Vector2.new(ep3.X,ep3.Y)

    local col = isTargeted and Color3.fromRGB(255,30,30)
        or curved and CFG.ColCurved
        or (appr and CFG.ColApproach or CFG.ColAway)

    sv(VIS.BallCircle,{Position=bp2,Color=col,Radius=math.clamp(18-bp3.Z*0.01,5,30),Visible=bOn})
    sv(VIS.TrajLine,  {From=bp2,To=pp2,Visible=bOn and pOn})
    sv(VIS.PredDot,   {Position=pp2,Visible=pOn and appr})
    sv(VIS.ConnLine,  {From=ep2,To=bp2,Visible=bOn and isTargeted})
    if bOn then
        local ttaS = tta==math.huge and "—" or string.format("%.3fs",tta)
        sv(VIS.InfoText,{
            Text=string.format("DST:%.1f  SPD:%.0f  TTA:%s%s%s",
                dist, spd, ttaS,
