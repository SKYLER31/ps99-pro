-- ─────────────────────────────────────────────────────────
--  MAIN LOOP — PreSimulation
-- ─────────────────────────────────────────────────────────
RunService.PreSimulation:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local ball = getBall()
    if not ball then
        if HUDFrame and HUDFrame.Visible then
            HUDLabel.Text = "⚽ <font color=\"rgb(100,200,255)\">Top Hızı:</font> —\n📐 <font color=\"rgb(80,220,180)\">Vektör:</font> —\n⚡ <font color=\"rgb(255,200,50)\">Peak Hız:</font> —\n🎯 <font color=\"rgb(255,255,255)\">Hedef:</font> —\n⏱ <font color=\"rgb(180,130,255)\">TTA:</font> —"
        end
        hideVis()
        return
    end

    local bv    = getBallVelocity(ball)
    local speed = bv.Magnitude
    local rawPing = getRawPing()

    recordSpeed(speed)

    -- Targeted?
    local ballTarget = ball:GetAttribute("target")
    local isTargeted = ballTarget == tostring(LP)

    -- Dot + curved detection
    local dir = hrp.Position - ball.Position
    local dot = dir.Magnitude > 0 and dir.Unit:Dot(bv.Unit) or 0
    updateDotHistory(ball, dot)
    local curved, avgAngle = isCurved(ball, bv)

    -- Parry range (ping-aware with cap)
    local range = calcRange(speed, rawPing, curved, avgAngle)

    -- Visualizer
    updateVis(ball, hrp, bv, range, isTargeted, curved)

    -- Accurate TTA
    local tta = getAbsoluteTTA(ball, hrp, bv)

    -- HUD
    if HUDFrame and HUDFrame.Visible then
        local targetName = ballTarget or "Yok"
        local targetColor = isTargeted and "rgb(255,55,55)" or "rgb(255,255,255)"
        local ttaDisplay = tta == math.huge and "—" or string.format("%.3fs", tta)
        local velStr = string.format("X:%.1f Y:%.1f Z:%.1f", bv.X, bv.Y, bv.Z)

        HUDLabel.Text = string.format(
            "⚽ <font color=\"rgb(100,200,255)\">Top Hızı:</font> %d st/s\n📐 <font color=\"rgb(80,220,180)\">Vektör:</font> [%s]\n⚡ <font color=\"rgb(255,200,50)\">Peak Hız:</font> %d st/s\n🎯 <font color=\"%s\">Hedef:</font> %s\n⏱ <font color=\"rgb(180,130,255)\">TTA:</font> %s",
            math.floor(speed),
            velStr,
            math.floor(SES.speed_max),
            targetColor,
            targetName,
            ttaDisplay
        )
    end

    if not CFG.AutoParry then return end
    if speed < 0.5 then return end
    if state.Parried then return end

    -- Ability checks
    if checkAbilities(char) then return end

    -- Tornado Check
    if CFG.TornadoDetect and Runtime then
        local tornado = Runtime:FindFirstChild("Tornado")
        if ball:FindFirstChild("AeroDynamicSlashVFX") then
            pcall(function() Debris:AddItem(ball.AeroDynamicSlashVFX, 0) end)
            state.TornadoTime = tick()
        end
        if tornado then
            local elapsedTornado = tick() - state.TornadoTime
            local tornadoDuration = (tornado:GetAttribute("TornadoTime") or 1) + 0.314
            if elapsedTornado < tornadoDuration then return end
        end
    end

    -- ── TRIGGER MECHANISM ──
    local shouldParry = false
    local dist = (hrp.Position - ball.Position).Magnitude
    
    if isTargeted then
        -- 1. TTA-based trigger (Ultimate precision)
        local pingSec = rawPing / 1000
        local baseDelay = 0.035
        local targetTTA = (pingSec * 1.05) + (baseDelay * getSDMult())
        
        if CFG.HighPingCompensation and rawPing > CFG.HighPingThreshold then
            targetTTA = targetTTA * 1.2
        end
        
        if tta ~= math.huge and tta <= targetTTA then
            shouldParry = true
        end
        
        -- 2. Distance fallback
        if dist <= range then
            shouldParry = true
        end
    elseif not ballTarget then
        -- free ball proximity check
        if dist <= range * 0.75 and dot > 0.4 then
            shouldParry = true
        end
    end

    if shouldParry then
        fireParry(false)
        state.Parried = true
        state.ParryTime = tick()
        state.Parries += 1
        task.delay(0.5, function()
            state.Parries = math.max(0, state.Parries - 1)
        end)

        task.spawn(function()
            repeat RunService.PreSimulation:Wait()
            until (tick() - state.ParryTime) >= 1 or not state.Parried
            state.Parried = false
            if not SES.last_ok then SES.streak = 0 end
            SES.last_ok = false
        end)

        ball:GetAttributeChangedSignal("target"):Once(function()
            state.Parried = false
        end)
    end
end)

