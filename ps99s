local manualActive = false
UserInputService.InputBegan:Connect(function(inp, gp)
    if gp then return end
    if inp.KeyCode == CFG.ManualSpamKey and not manualActive then
        manualActive = true
        task.spawn(function()
            while manualActive do fireParry(true); task.wait(CFG.SpamDelay) end
        end)
    end
end)
UserInputService.InputEnded:Connect(function(inp)
    if inp.KeyCode == CFG.ManualSpamKey then manualActive=false end
end)

