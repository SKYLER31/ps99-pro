local function secureHooks()
    if typeof(hookmetamethod) ~= "function" then return end
    
    local oldNameCall
    oldNameCall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if method == "FireServer" and self:IsA("RemoteEvent") then
            local name = self.Name:lower()
            
            -- String matching detection
            if name:find("parry") or name:find("deflect") or name:find("block") or name:find("hit") or name:find("swing") or name:find("press") then
                if not ParryRemote then
                    ParryRemote = self
                    ParryArgs = args
                end
            end
            
            -- Input-correlation detection (masterpiece bypass)
            local now = tick()
            if state.LastPlayerInputTime and (now - state.LastPlayerInputTime) < 0.1 then
                if not name:find("chat") and not name:find("ping") and not name:find("log") and not name:find("teleport") then
                    if not ParryRemote then
                        ParryRemote = self
                        ParryArgs = args
                    end
                end
            end
        end
        
        -- Bypass kick detections safely
        if method == "Kick" and self == LP then
            warn("[BB] Game tried to kick the player!")
            return task.wait(9e9)
        end
        
        return oldNameCall(self, unpack(args))
    end))
    
    -- Dual hook function for executors without proper __namecall support
    if typeof(hookfunction) == "function" then
        local r = Instance.new("RemoteEvent")
        local oldFireServer
        oldFireServer = hookfunction(r.FireServer, newcclosure(function(self, ...)
            local name = self.Name:lower()
            local args = {...}
            
            if name:find("parry") or name:find("deflect") or name:find("block") or name:find("hit") or name:find("swing") or name:find("press") then
                if not ParryRemote then
                    ParryRemote = self
                    ParryArgs = args
                end
            end
            
            local now = tick()
            if state.LastPlayerInputTime and (now - state.LastPlayerInputTime) < 0.1 then
                if not name:find("chat") and not name:find("ping") and not name:find("log") and not name:find("teleport") then
                    if not ParryRemote then
                        ParryRemote = self
                        ParryArgs = args
                    end
                end
            end
            return oldFireServer(self, unpack(args))
        end))
    end
end
task.spawn(pcall, secureHooks)

-- Optimized scanning of ReplicatedStorage
local function scanForRemote()
    local targetFolders = {
        ReplicatedStorage,
        ReplicatedStorage:FindFirstChild("Remotes"),
        ReplicatedStorage:FindFirstChild("Events"),
        ReplicatedStorage:FindFirstChild("Remote"),
    }
    for _, folder in ipairs(targetFolders) do
        if folder then
            for _, v in ipairs(folder:GetChildren()) do
                if v:IsA("RemoteEvent") then
                    local n = v.Name:lower()
                    if n:find("parry") or n:find("deflect") or n:find("block")
                        or n:find("swing") or n:find("hit") or n:find("bounce") then
                        ParryRemote = v
                        return true
                    end
                end
            end
        end
    end
    
    -- Safe recursive scan (yielding to prevent freezing)
    local count = 0
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        count = count + 1
        if count % 200 == 0 then task.wait() end
        if v:IsA("RemoteEvent") then
            local n = v.Name:lower()
            if n:find("parry") or n:find("deflect") or n:find("block")
                or n:find("swing") or n:find("hit") or n:find("bounce") then
                ParryRemote = v
                return true
            end
        end
    end
    return false
end

task.spawn(function()
    task.wait(1.5)
    if not ParryRemote then scanForRemote() end
end)

