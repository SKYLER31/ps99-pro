-- Stats updater
local function refreshStats(rawPing)
    local miss = math.max(0, SES.parry_fired - SES.parry_success)
    local acc  = getAcc()
    if StatRows["Session"]    then StatRows["Session"].Text    = sesTime() end
    if StatRows["Accuracy"]   then
        StatRows["Accuracy"].Text = acc.."%"
        StatRows["Accuracy"].TextColor3 = acc>=80 and Color3.fromRGB(50,255,120)
            or acc>=50 and Color3.fromRGB(255,200,50) or Color3.fromRGB(255,80,80) end
    if StatRows["Fired"]      then StatRows["Fired"].Text      = tostring(SES.parry_fired) end
    if StatRows["Success"]    then StatRows["Success"].Text    = tostring(SES.parry_success) end
    if StatRows["Miss"]       then StatRows["Miss"].Text       = tostring(miss) end
    if StatRows["Streak"]     then StatRows["Streak"].Text     = tostring(SES.streak) end
    if StatRows["Best Streak"]then StatRows["Best Streak"].Text= tostring(SES.streak_best) end
    if StatRows["Speed Now"]  then StatRows["Speed Now"].Text  = string.format("%.0f st/s",SES.speed_current) end
    if StatRows["Speed Avg"]  then StatRows["Speed Avg"].Text  = string.format("%.0f st/s",SES.speed_avg) end
    if StatRows["Speed Max"]  then StatRows["Speed Max"].Text  = string.format("%.0f st/s",SES.speed_max) end
    if StatRows["Ping"]       then StatRows["Ping"].Text       = string.format("%.0f ms",rawPing) end
    if SpeedBar and SES.speed_max > 0 then
        local pct = math.clamp(SES.speed_current/SES.speed_max,0,1)
        TweenService:Create(SpeedBar,TweenInfo.new(0.1),{Size=UDim2.new(pct,0,1,0)}):Play()
        SpeedBar.BackgroundColor3 = pct>0.75 and Color3.fromRGB(255,80,80)
            or pct>0.4 and Color3.fromRGB(255,180,50) or Color3.fromRGB(100,200,255)
    end
end

