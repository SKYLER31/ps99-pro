--  CLOSEST ENEMY
-- ─────────────────────────────────────────────────────────
local closestEntity = nil

local function updateClosest(fromPos)
    local aliveFolder = Alive
    if not aliveFolder then return end
    local best, bd = nil, math.huge
    for _, e in ipairs(aliveFolder:GetChildren()) do
        if e.Name ~= LP.Name then
            local hrp = e:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (fromPos - hrp.Position).Magnitude
                if d < bd then bd = d; best = e end
            end
        end
    end
    closestEntity = best
end

