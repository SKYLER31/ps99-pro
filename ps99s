-- ─────────────────────────────────────────────────────────
--  CURVED BALL DETECTION — dot history (Oxyo Hub method)
-- ─────────────────────────────────────────────────────────
local function updateDotHistory(ball, dot)
    if not state.DotHistories[ball] then state.DotHistories[ball] = {} end
    table.insert(state.DotHistories[ball], dot)
    if #state.DotHistories[ball] > 5 then table.remove(state.DotHistories[ball],1) end
end

local function isCurved(ball)
    local hist = state.DotHistories[ball]
    if not hist or #hist < 3 then return false, false end
    -- all dots positive → approaching but was going backwards = curved
    local neg = 0
    for _, d in ipairs(hist) do if d < 0 then neg+=1 end end
    local backwardsDetected = neg >= 2
    local curved = backwardsDetected
    return curved, backwardsDetected
end

-- ─────────────────────────────────────────────────────────
--  PARRY RANGE — Oxyo Hub verified formula
--  speedDivisorBase = 2.4 + clamp(speed-9.5, 0, 820)*0.002
--  speedDivisor = speedDivisorBase * SDMult
--  parryAccuracy = adjustedPing + max(speed/speedDivisor, 9.5)
--  curved correction applied if needed
-- ─────────────────────────────────────────────────────────
local function calcRange(speed, rawPing, curved, backwardsDetected)
    local cappedDiff = math.min(math.max(speed - 9.5, 0), 820)
    local divisorBase = 2.4 + cappedDiff * 0.002
    local divisor = divisorBase * getSDMult()
    local adjPing = rawPing / 10
    if CFG.HighPingCompensation and rawPing > CFG.HighPingThreshold then
        adjPing = adjPing * 1.5
    end
    local range = adjPing + math.max(speed / divisor, 9.5)

    -- Curved reduction (Oxyo Hub table)
    if curved and backwardsDetected then
        local r = speed > 700 and 85 or speed > 600 and 75 or speed > 500 and 68 or speed > 400 and 62 or 55
        range = range - r
    elseif curved then
        local r = speed > 700 and 58 or speed > 600 and 52 or speed > 500 and 46 or speed > 400 and 42 or 38
        range = range - r
    end
    return math.max(range, 1)
end

