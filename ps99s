local function trackDeathSlash()
    if not Alive then return end
    Alive.ChildRemoved:Connect(function(char)
        if not CFG.AutoPreClick or not ParryRemote then return end
        local ball = getBall()
        if not ball then return end
        local target = ball:GetAttribute("target")
        if target == char.Name then
            local bv = getBallVelocity(ball)
            local speed = bv.Magnitude
            if speed >= 200 then
                local delay = math.random(120, 150) / 1000
                task.delay(delay, function()
                    local currentBall = getBall()
                    if currentBall == ball and ball:GetAttribute("target") == tostring(LP) and not state.Parried then
                        fireParry(false)
                        state.Parried = true
                        state.ParryTime = tick()
                        task.delay(0.5, function() state.Parried = false end)
                    end
                end)
            end
        end
    end)
end
