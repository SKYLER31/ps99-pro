--  ABILITY CHECKS
-- ─────────────────────────────────────────────────────────
local function checkAbilities(char)
    local hotbar = LP.PlayerGui and LP.PlayerGui:FindFirstChild("Hotbar")
    local abilities = char and char:FindFirstChild("Abilities")
    local durationUI = hotbar and hotbar:FindFirstChild("Ability")
        and hotbar.Ability:FindFirstChild("Duration")
        and hotbar.Ability.Duration.Visible

    local singCape = char and char.PrimaryPart
        and char.PrimaryPart:FindFirstChild("SingularityCape")
    if CFG.SingularityDetect and singCape then return true end

    local inf = abilities and abilities:FindFirstChild("Infinity")
    if CFG.InfinityDetect and durationUI and inf and inf.Enabled and state.InfinityBall then
        return true
    end

    local th = abilities and abilities:FindFirstChild("Time Hole")
    if CFG.TimeHoleDetect and durationUI and th and th.Enabled then
        return true
    end

    return false
end

-- ─────────────────────────────────────────────────────────
--  FIRE PARRY
-- ─────────────────────────────────────────────────────────
local lastFireTime = 0

local function fireParry(isSpam)
    local now = tick()
    if now - lastFireTime < CFG.SpamDelay then return end
    lastFireTime = now

    SES.parry_fired += 1
    if not isSpam then saveStats() end

    -- Method 1: Use captured remote (with fallback signatures)
    if ParryRemote then
        local ok = pcall(function()
            if ParryArgs and #ParryArgs > 0 then
                ParryRemote:FireServer(unpack(ParryArgs))
            else
                ParryRemote:FireServer()
            end
        end)
        if ok then return end
        
        -- Signature fallbacks
        pcall(function() ParryRemote:FireServer() end)
        pcall(function()
            local tp = Vector3.zero
            if closestEntity then
                local hrp = closestEntity:FindFirstChild("HumanoidRootPart")
                if hrp then tp = hrp.Position end
            end
            ParryRemote:FireServer(0.5, tp, {})
        end)
        return
    end

    -- Method 2: Simulate keyboard F input (universal support)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.01)
        vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end)

    -- Method 3: Mouse click fallback
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2, 0, true, game, 1)
        task.wait(0.01)
        vim:SendMouseButtonEvent(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2, 0, false, game, 1)
    end)
end

-- ─────────────────────────────────────────────────────────
--  AUTO PRE-CLICK (TARGET SWAP PROTECTION)
-- ─────────────────────────────────────────────────────────
local function trackDeathSlash()
    task.spawn(function()
        local aliveFolder = workspace:WaitForChild("Alive", 60)
        if not aliveFolder then return end
        aliveFolder.ChildRemoved:Connect(function(char)
            if not CFG.AutoPreClick then return end
            local ball = getBall()
            if not ball then return end
            local target = ball:GetAttribute("target")
            if target == char.Name then
                local bv = getBallVelocity(ball)
                local speed = bv.Magnitude
                if speed >= 200 then
                    local delay = math.random(120, 150) / 1000
                    task.delay(delay, function()
                        local currentBall = getBall()
                        if currentBall == ball and ball:GetAttribute("target") == tostring(LP) and not state.Parried then
                            fireParry(false)
                            state.Parried = true
                            state.ParryTime = tick()
                            task.delay(0.5, function() state.Parried = false end)
                        end
                    end)
                end
            end
        end)
    end)
end
trackDeathSlash()

