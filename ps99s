local function getBallVelocity(ball)
    local z = ball:FindFirstChild("zoomies")
    if z then
        local ok, vv = pcall(function() return z.Value end)
        if ok and typeof(vv) == "Vector3" then return vv end
        local ok2, vv2 = pcall(function() return z.VectorVelocity end)
        if ok2 and vv2 then return vv2 end
    end
    local ok, vel = pcall(function() return ball.AssemblyLinearVelocity end)
    if ok and vel then return vel end
    return Vector3.zero
end

-- ─────────────────────────────────────────────────────────
--  WALL BOUNCE RAYCAST PREDICTION
-- ─────────────────────────────────────────────────────────
local function predictBounce(ball, hrp, bv)
    local bp = ball.Position
    local vel = bv
    local speed = vel.Magnitude
    if speed < 1 then return bp, vel, false end
    
    local dir = vel.Unit
    local maxDist = (hrp.Position - bp).Magnitude
    
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {ball, LP.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    -- Raycast along velocity vector to find walls
    local result = workspace:Raycast(bp, dir * maxDist, params)
    if result and result.Instance and result.Instance.CanCollide then
        local hitPos = result.Position
        local hitNormal = result.Normal
        
        -- Reflect velocity: V_new = V - 2*(V . Normal)*Normal
        local reflectedVel = vel - 2 * vel:Dot(hitNormal) * hitNormal
        return hitPos, reflectedVel, true
    end
    return bp, vel, false
end

-- ─────────────────────────────────────────────────────────
--  ACCURATE TIME-TO-ARRIVE (TTA) SOLVER
-- ─────────────────────────────────────────────────────────
local function getAbsoluteTTA(ball, hrp, bv)
    local bp = ball.Position
    local pp = hrp.Position
    local speed = bv.Magnitude
    if speed < 0.5 then return math.huge end
    
    -- Check for wall bounce first
    local hitPos, reflectedVel, bounced = predictBounce(ball, hrp, bv)
    if bounced then
        local distToWall = (hitPos - bp).Magnitude
        local distFromWall = (pp - hitPos).Magnitude
        
        -- total time = path distance / speed
        local tta = (distToWall + distFromWall) / speed
        
        -- Verify that the reflected velocity actually heads towards the player
        local dirToPlayer = (pp - hitPos).Unit
        local dot = reflectedVel.Unit:Dot(dirToPlayer)
        if dot < 0.15 then
            return math.huge -- reflected ball misses the player
        end
        return tta
    else
        -- Standard straight-line quadratic solver
        local rel = bp - pp
        local a = bv:Dot(bv)
        local b = 2 * rel:Dot(bv)
        local c = rel:Dot(rel)
        
        local dc = b*b - 4*a*c
        if dc < 0 then return math.huge end
        
        local sq = math.sqrt(dc)
        local t1 = (-b - sq) / (2 * a)
        local t2 = (-b + sq) / (2 * a)
        
        local t = math.huge
        if t1 >= 0 then t = t1 end
        if t2 >= 0 and t2 < t then t = t2 end
        return t
    end
end

-- ─────────────────────────────────────────────────────────
--  CURVED BALL DETECTION
-- ─────────────────────────────────────────────────────────
local function updateDotHistory(ball, dot)
    if not state.DotHistories[ball] then state.DotHistories[ball] = {} end
    table.insert(state.DotHistories[ball], dot)
    if #state.DotHistories[ball] > 8 then table.remove(state.DotHistories[ball],1) end
end

local function isCurved(ball, bv)
    if not state.VelHistories[ball] then state.VelHistories[ball] = {} end
    table.insert(state.VelHistories[ball], bv)
    if #state.VelHistories[ball] > 6 then table.remove(state.VelHistories[ball], 1) end
    
    local vHist = state.VelHistories[ball]
    if #vHist < 3 then return false, 0 end
    
    -- Calculate average angular change between consecutive frames
    local totalAngle = 0
    for i = 1, #vHist - 1 do
        local v1 = vHist[i].Unit
        local v2 = vHist[i+1].Unit
        local dotVal = math.clamp(v1:Dot(v2), -1, 1)
        totalAngle = totalAngle + math.acos(dotVal)
    end
    
    local avgAngleDeg = math.deg(totalAngle / (#vHist - 1))
    local curved = avgAngleDeg > 2.8
    return curved, avgAngleDeg
end

-- ─────────────────────────────────────────────────────────
--  PARRY RANGE FORMULA
-- ─────────────────────────────────────────────────────────
local function calcRange(speed, rawPing, curved, avgAngle)
    local cappedDiff = math.min(math.max(speed - 9.5, 0), 820)
    local divisorBase = 2.45 + cappedDiff * 0.002
    local divisor = divisorBase * getSDMult()
    local adjPing = rawPing / 10
    if CFG.HighPingCompensation and rawPing > CFG.HighPingThreshold then
        adjPing = adjPing * 1.35
    end
    local range = adjPing + math.max(speed / divisor, 9.5)

    if curved then
        -- Scale range reduction dynamically with curved angle severity
        local curveReductionFactor = math.clamp(avgAngle / 16, 0.15, 0.45)
        range = range * (1 - curveReductionFactor)
    end
    
    -- Absolute minimum distance to guarantee parry registers (ping-aware)
    local minSafeDist = (rawPing / 1000 + 0.035) * speed + 6
    if range < minSafeDist then
        range = minSafeDist
    end
    
    return range
end

