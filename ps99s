-- ─────────────────────────────────────────────────────────
--  ANA LOOP — PreSimulation (Oxyo Hub uses PreSimulation)
-- ─────────────────────────────────────────────────────────
RunService.PreSimulation:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local ball = getBall()
    if not ball then
        if HUDFrame and HUDFrame.Visible then
            HUDLabel.RichText = true
            HUDLabel.Text = "⚽ <font color=\"rgb(100,200,255)\">Top Hızı:</font> —\n⚡ <font color=\"rgb(255,200,50)\">Peak Hız:</font> —\n🎯 <font color=\"rgb(255,255,255)\">Hedef:</font> —\n⏱ <font color=\"rgb(180,130,255)\">TTA:</font> —"
        end
        hideVis()
        return
    end

    -- Ball velocity
    local bv    = getBallVelocity(ball)
    local speed = bv.Magnitude
    local rawPing = getRawPing()

    recordSpeed(speed)

    -- Future position (Oxyo Hub method)
    local dt      = rawPing / 2000
    local ballFut = ball.Position + bv * dt
    local hrpFut  = hrp.Position + hrp.AssemblyLinearVelocity * dt
    local dist    = (hrpFut - ballFut).Magnitude   -- ping-aware distance

    -- Targeted?
    local isTargeted = ball:GetAttribute("target") == tostring(LP)

    -- Dot + curved detection
    local dir = hrp.Position - ball.Position
    local dot = dir.Magnitude > 0 and dir.Unit:Dot(bv.Unit) or 0
    updateDotHistory(ball, dot)
    local curved, backwardsDetected = isCurved(ball)

    -- Velocity history
    if not state.VelHistories[ball] then state.VelHistories[ball] = {} end
    table.insert(state.VelHistories[ball], bv)
    if #state.VelHistories[ball] > 5 then table.remove(state.VelHistories[ball],1) end

    -- Parry range
    local range = calcRange(speed, rawPing, curved, backwardsDetected)

    -- Visualizer
    updateVis(ball, hrp, bv, range, isTargeted, curved)

    -- HUD Overlay Updater
    if HUDFrame and HUDFrame.Visible then
        local tta = math.huge
        if speed > 0.1 then
            local rel = ball.Position - hrp.Position
            local a,b,c_ = bv:Dot(bv), 2*rel:Dot(bv), rel:Dot(rel)-range*range
            local dc = b*b - 4*a*c_
            if dc >= 0 then
                local sq = math.sqrt(dc)
                local t1 = (-b-sq)/(2*a); local t2 = (-b+sq)/(2*a)
                local t = math.huge
                if t1 >= 0 then t=t1 end
                if t2 >= 0 and t2<t then t=t2 end
                tta = t
            end
        end

        local targetName = ball:GetAttribute("target") or "Yok"
        local targetColor = isTargeted and "rgb(255,55,55)" or "rgb(255,255,255)"
        local ttaDisplay = tta == math.huge and "—" or string.format("%.3fs", tta)
        
        HUDLabel.RichText = true
        HUDLabel.Text = string.format(
            "⚽ <font color=\"rgb(100,200,255)\">Top Hızı:</font> %d st/s\n⚡ <font color=\"rgb(255,200,50)\">Peak Hız:</font> %d st/s\n🎯 <font color=\"%s\">Hedef:</font> %s\n⏱ <font color=\"rgb(180,130,255)\">TTA:</font> %s",
            math.floor(speed),
            math.floor(SES.speed_max),
            targetColor,
            targetName,
            ttaDisplay
        )
    end

    if not CFG.AutoParry or speed < 0.5 then return end
    if not isTargeted then return end
    if state.Parried then return end

    -- Ability checks (skip parry if ability active)
    if checkAbilities(char) then return end

    -- Tornado / Windfield Check
    if CFG.TornadoDetect then
        local tornado = Runtime and Runtime:FindFirstChild("Tornado")
        if ball:FindFirstChild("AeroDynamicSlashVFX") then
            pcall(function() Debris:AddItem(ball.AeroDynamicSlashVFX, 0) end)
            state.TornadoTime = tick()
        end
        if tornado then
            local elapsedTornado = tick() - state.TornadoTime
            local tornadoDuration = (tornado:GetAttribute("TornadoTime") or 1) + 0.314
            if elapsedTornado < tornadoDuration then return end
        end
    end

    -- Predicted dot (Oxyo Hub: skip if predicted_dot < -0.3)
    local predDir = (hrpFut - ballFut)
    local predDot = predDir.Magnitude > 0 and predDir.Unit:Dot(bv.Unit) or 0
    if predDot < -0.3 then return end

    -- Closest enemy
    updateClosest(hrp.Position)

    -- TRIGGER
    if dist <= range and ParryRemote then
        fireParry(false)
        state.Parried = true
        state.ParryTime = tick()
        state.Parries += 1
        task.delay(0.5, function()
            state.Parries = math.max(0, state.Parries - 1)
        end)

        -- Reset after 1 second (Oxyo Hub: PreSimulation wait)
        task.spawn(function()
            repeat RunService.PreSimulation:Wait()
            until (tick() - state.ParryTime) >= 1 or not state.Parried
            state.Parried = false
            if not SES.last_ok then SES.streak = 0 end
            SES.last_ok = false
        end)

        -- Reset on ball target change (Oxyo Hub method)
        ball:GetAttributeChangedSignal("target"):Once(function()
            state.Parried = false
        end)
    end
end)

